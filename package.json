{
  "name": "habit-cli",
  "version": "0.1.0",
  "description": "A clean, fast CLI habit and task tracker",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "habit": "./dist/bin/habit.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/habit.ts",
    "start": "node dist/bin/habit.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "habit",
    "tracker",
    "cli",
    "productivity",
    "streak"
  ],
  "author": "Alex (ZazenCodes)",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
